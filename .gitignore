# matplotlib cache
.matplotlib/

# Claude Code per-machine settings
.claude/settings.local.json

# Claude's memory stays per-computer, never in the repo
claude-memory/

# Third-party material kept local, never committed
*.pdf
cfront/
benchmark_results/.cache/
